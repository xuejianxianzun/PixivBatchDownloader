{
  "name": "Powerful Pixiv Downloader",
  "version": "19.3.0",
  "manifest_version": 3,
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "browser_specific_settings": {
    "gecko": {
      "id": "PowerfulPixivDownloader@pixiv.download"
    }
  },
  "icons": {
    "16": "icons/logo16.png",
    "32": "icons/logo32.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo16.png",
      "32": "icons/logo32.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    },
    "default_title": "Powerful Pixiv Downloader"
  },
  "commands": {
    "toggle-settings-panel": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "__MSG_command_toggle_settings_panel__"
    },
    "start-default-crawl": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_command_start_default_crawl__"
    },
    "toggle-select-work": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_command_toggle_select_work__"
    },
    "toggle-exclude-work": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "__MSG_command_toggle_exclude_work__"
    },
    "toggle-preview-work": {
      "description": "__MSG_command_toggle_preview_work__"
    },
    "quick-download": {
      "description": "__MSG_command_quick_download__"
    },
    "quick-bookmark": {
      "description": "__MSG_command_quick_bookmark__"
    },
    "copy-work-info": {
      "description": "__MSG_command_copy_work_info__"
    }
  },
  "content_scripts": [{
      "js": [
        "js/injectScript.js"
      ],
      "matches": ["*://www.pixiv.net/*"],
      "exclude_matches": [
        "*://www.pixiv.net/ajax*",
        "*://www.pixiv.net/*format=json*",
        "*://www.pixiv.net/*messages*"
      ],
      "run_at": "document_start"
    },
    {
      "css": ["style/viewer.min.css", "style/style.css"],
      "js": [
        "lib/viewer.min.js",
        "lib/gif.js",
        "lib/jszip-utils.min.js",
        "lib/jszip.min.js",
        "lib/jepub.js",
        "lib/pako.min.js",
        "lib/ppd-webp.js",
        "lib/icon-sprite.js",
        "js/content.js"
      ],
      "matches": ["*://www.pixiv.net/*"],
      "exclude_matches": [
        "*://www.pixiv.net/ajax*",
        "*://www.pixiv.net/*format=json*",
        "*://www.pixiv.net/*messages*"
      ],
      "run_at": "document_end"
    },
    {
      "css": ["style/style.css"],
      "js": ["lib/icon-sprite.js", "js/content.js"],
      "matches": ["*://www.pixivision.net/*"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "preferred_environment": ["service_worker"],
    "service_worker": "js/background.js",
    "scripts": ["js/background.js"]
  },
  "permissions": [
    "downloads",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "*://www.pixiv.net/*",
    "*://www.pixivision.net/*",
    "*://*.pximg.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "declarative_net_request_rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/ppd-webp.worker.js",
        "lib/whammy.js",
        "lib/whammy.worker.js",
        "lib/pako.min.js",
        "lib/UPNG.js",
        "lib/apng.worker.js",
        "lib/gif.worker.js",
        "lib/listen_history_change.js",
        "lib/api_interceptor.js",
        "manifest.json",
        "icons/logo128.png",
        "style/showLargerThumbnails.css"
      ],
      "matches": ["*://www.pixiv.net/*", "*://www.pixivision.net/*"]
    }
  ],
  "homepage_url": "https://github.com/xuejianxianzun/PixivBatchDownloader"
}
